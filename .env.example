# ===== LABEL LAB · Server-side secrets (Vercel → Settings → Environment Variables) =====
# Kopiera till .env.local för lokal utveckling. Lägg ALDRIG riktiga värden i Git.
# Alla lösenord ska vara scrypt-hashar:  node scripts/hash-password.mjs "lösenord"

# --- Konton (rollerna styrs i Supabase app_users, aldrig i klienten) ---
STILLE_PASSWORD=                      # säljare · scrypt:...  (äldre namn: SELLER_PASSWORD fungerar under övergången)
AFFE_PASSWORD=                        # chef   · scrypt:...  (äldre namn: MANAGER_PASSWORD fungerar under övergången)
FREDLAND_PASSWORD=                    # chef   · exakt samma rättigheter som Affe
KVIST_PASSWORD=                       # säljare · exakt samma rättigheter som Stille

# --- Session (HMAC-signerad HttpOnly-cookie, 12 h) ---
SESSION_SECRET=                       # minst 32 slumpmässiga tecken, t.ex. `openssl rand -hex 32`

# --- Supabase (service role – endast servern) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=                  # nyare sb_secret_… nyckel (eller SUPABASE_SERVICE_ROLE_KEY)

# --- AI-coach (Anthropic) ---
ANTHROPIC_API_KEY=                    # sk-ant-…
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Vercel ---
VERCEL_ENV=production
